{
  "name": "excalidraw-animation-desktop",
  "version": "0.1.16",
  "private": true,
  "description": "Excaliall — sketch diagrams with animations, data graphs and editable tables",
  "author": "David Corr",
  "license": "MIT",
  "main": "main.cjs",
  "repository": "https://github.com/davidgcorr/excaliall",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:windows": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "desktopName": "excalidraw-animation.desktop"
}
